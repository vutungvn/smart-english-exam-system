            "description": "Lỗi, error.code thuộc: UNAUTHORIZED, AUTH_INVALID_CREDENTIALS, AUTH_REFRESH_TOKEN_INVALID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi, error.code thuộc: INTERNAL_SERVER_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Xem lịch sử đăng nhập của chính mình, mới nhất trước",
        "tags": [
          "Me"
        ]
      }
    },
    "/api/v1/me/password": {
      "patch": {
        "description": "Thành công thì đăng xuất mọi thiết bị; FE gọi lại POST /auth/login bằng mật khẩu mới.",
        "operationId": "changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "status",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "data": {
                      "type": "object",
                      "nullable": true,
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Lỗi, error.code thuộc: BAD_REQUEST, VALIDATION_ERROR, AUTH_TOKEN_INVALID, AUTH_CURRENT_PASSWORD_INCORRECT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Lỗi, error.code thuộc: UNAUTHORIZED, AUTH_INVALID_CREDENTIALS, AUTH_REFRESH_TOKEN_INVALID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi, error.code thuộc: INTERNAL_SERVER_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Đổi mật khẩu",
        "tags": [
          "Me"
        ]
      }
    }
  },
  "info": {
    "title": "Smart English Exam System API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "VALIDATION_ERROR",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "VERSION_CONFLICT",
          "GONE",
          "PAYLOAD_TOO_LARGE",
          "UNPROCESSABLE_ENTITY",
          "TOO_MANY_REQUESTS",
          "INTERNAL_SERVER_ERROR",
          "SERVICE_UNAVAILABLE",
          "AUTH_INVALID_CREDENTIALS",
          "AUTH_EMAIL_NOT_VERIFIED",
          "AUTH_ACCOUNT_PENDING_APPROVAL",
          "AUTH_ACCOUNT_LOCKED",
          "AUTH_REFRESH_TOKEN_INVALID",
          "AUTH_EMAIL_ALREADY_EXISTS",
          "AUTH_TOKEN_INVALID",
          "AUTH_TOO_MANY_LOGIN_ATTEMPTS",
          "AUTH_CURRENT_PASSWORD_INCORRECT"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email",
            "description": "Trường lỗi, trường lồng nhau dạng address.city"
          },
          "message": {
            "type": "string",
            "example": "Email không hợp lệ"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "example": "VALIDATION_ERROR",
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "example": "Dữ liệu gửi lên không hợp lệ"
          },
          "details": {
            "description": "VALIDATION_ERROR: danh sách lỗi theo trường. Mã khác có thể chứa dữ liệu riêng, ví dụ { retryAfterSeconds }",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "status": {
            "type": "integer",
            "example": 400,
            "description": "Luôn trùng HTTP status code"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "success",
          "status",
          "error"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "PENDING_VERIFICATION",
          "PENDING_APPROVAL",
          "ACTIVE",
          "LOCKED"
        ]
      },
      "RegisterResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "hocvien@gmail.com"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "status"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn A",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "hocvien@gmail.com",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "example": "MatKhau123",
            "minLength": 8,
            "maxLength": 72,
            "description": "Mật khẩu dài 8-72 ký tự, gồm ít nhất một chữ hoa, một chữ thường và một chữ số"
          },
          "confirmPassword": {
            "type": "string",
            "example": "MatKhau123"
          },
          "acceptTerms": {
            "type": "boolean",
            "example": true,
            "description": "Đồng ý Điều khoản sử dụng và Chính sách xử lý dữ liệu cá nhân"
          }
        },
        "required": [
          "fullName",
          "email",
          "password",
          "confirmPassword",
          "acceptTerms"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token trong liên kết xác minh (phần sau \"token=\")",
            "example": "q3Zb1k0yXo9mQ2...43 ký tự"
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "hocvien@gmail.com",
            "maxLength": 255
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token trong liên kết đặt lại mật khẩu (phần sau \"token=\")"
          },
          "newPassword": {
            "type": "string",
            "example": "MatKhauMoi123",
            "minLength": 8,
            "maxLength": 72,
            "description": "Mật khẩu dài 8-72 ký tự, gồm ít nhất một chữ hoa, một chữ thường và một chữ số"
          },
          "confirmPassword": {
            "type": "string",
            "example": "MatKhauMoi123"
          }
        },
        "required": [
          "token",
          "newPassword",
          "confirmPassword"
        ]
      },
      "RoleCode": {
        "type": "string",
        "enum": [
          "STUDENT",
          "TEACHER",
          "ADMIN"
        ]
      },
      "AuthSessionUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "hocvien@gmail.com"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn A"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleCode"
              }
            ]
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "true: FE chuyển thẳng tới trang Đổi mật khẩu (admin mặc định từ seed)"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "mustChangePassword"
        ]
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "example": 900,
            "description": "Số giây access token còn hiệu lực, FE dùng để biết khi nào cần làm mới"
          },
          "user": {
            "$ref": "#/components/schemas/AuthSessionUser"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@gmail.com",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "example": "12345678",
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Level": {
        "type": "string",
        "enum": [
          "BEGINNER",
          "INTERMEDIATE",
          "ADVANCED"
        ]
      },
      "StudentProfile": {
        "type": "object",
        "properties": {
          "currentLevel": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Level"
              }
            ]
          },
          "currentScore": {
            "type": "integer",
            "nullable": true,
            "example": 550
          },
          "targetScore": {
            "type": "integer",
            "nullable": true,
            "example": 750
          }
        },
        "required": [
          "currentLevel",
          "currentScore",
          "targetScore"
        ]
      },
      "MeProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "hocvien@gmail.com"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn A"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleCode"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "mustChangePassword": {
            "type": "boolean"
          },
          "emailVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "student": {
            "nullable": true,
            "description": "null với giáo viên và admin",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/StudentProfile"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "avatarUrl",
          "role",
          "status",
          "mustChangePassword",
          "emailVerifiedAt",
          "lastLoginAt",
          "createdAt",
          "updatedAt",
          "student"
        ]
      },
      "LoginHistoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "success": {
            "type": "boolean"
          },
          "failureReason": {
            "type": "string",
            "nullable": true,
            "example": "INVALID_PASSWORD",
            "description": "Mã lý do khi thất bại, ví dụ INVALID_PASSWORD, TOO_MANY_ATTEMPTS; null khi thành công"
          },
          "ipAddress": {
            "type": "string",
            "nullable": true,
            "example": "127.0.0.1"
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "success",
          "failureReason",
          "ipAddress",
          "userAgent",
          "createdAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 42
          },
          "totalPages": {
            "type": "integer",
            "example": 3,
            "description": "0 khi không có bản ghi nào"
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn A",
            "minLength": 2,
            "maxLength": 100
          },
          "targetScore": {
            "type": "number",
            "example": 750,
            "minimum": 10,
            "maximum": 990,
            "description": "Điểm TOEIC Listening + Reading mục tiêu, bước 5 điểm (chỉ học viên)"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "MatKhau123"
          },
          "newPassword": {
            "type": "string",
            "example": "MatKhauMoi123",
            "minLength": 8,
            "maxLength": 72,
            "description": "Mật khẩu dài 8-72 ký tự, gồm ít nhất một chữ hoa, một chữ thường và một chữ số"
          },
          "confirmPassword": {
            "type": "string",
            "example": "MatKhauMoi123"
          }
        },
        "required": [
          "currentPassword",
          "newPassword",
          "confirmPassword"
        ]
      }
    }
  }
}
