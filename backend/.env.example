# Môi trường chạy: development | test | production
NODE_ENV=development

# Cổng HTTP của API
PORT=3000

# PostgreSQL (khớp với service postgres trong infra/docker-compose.yml)
DATABASE_URL=

# JWT access token: secret dài ít nhất 32 ký tự
# Sinh bằng: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Thời hạn access token (giây)
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# Redis: refresh token, bộ đếm, cache (khớp với service redis trong infra/docker-compose.yml)
REDIS_URL=

# Gửi mail (SMTP)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS là App Password 16 ký tự
#        (tạo tại https://myaccount.google.com/apppasswords, cần bật Xác minh 2 bước)
# Mailpit (không gửi thật): SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false, để trống USER/PASS
#        xem thư tại http://localhost:8025
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Với Gmail, địa chỉ ở đây phải trùng SMTP_USER
MAIL_FROM=

# URL frontend, dùng tạo link trong email xác minh / đặt lại mật khẩu
APP_URL=http://localhost:5173

# Đăng nhập bằng Google (OAuth 2.0). Để trống CLIENT_ID/SECRET thì tắt tính năng này.
# Tạo tại https://console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải trùng "Authorized redirect URIs" đã khai báo trên Google; đi qua Vite proxy để cookie cùng origin với FE
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

