# Môi trường chạy: development | test | production
NODE_ENV=development

# Cổng HTTP của API
PORT=3000

# PostgreSQL (khớp với service postgres trong docker-compose.yml)
DATABASE_URL=

# Redis: cache, refresh token, hàng đợi BullMQ
REDIS_URL=

# SMTP: ở dev gửi vào Mailpit, xem thư tại http://localhost:8025
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=
