# Môi trường chạy: development | test | production
NODE_ENV=development

# Cổng HTTP của API
PORT=3000

# PostgreSQL (khớp với service postgres trong infra/docker-compose.yml)
DATABASE_URL=

# JWT access token: secret dài ít nhất 32 ký tự
# Sinh bằng: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Thời hạn access token (giây)
JWT_ACCESS_TTL=

