# Cấu hình Nginx production (SPRINT-80). Image nginx tự thay ${APP_DOMAIN} khi khởi động rồi ghi ra
# /etc/nginx/conf.d/default.conf. Biến của Nginx ($host, $uri...) không phải biến môi trường nên giữ nguyên.

# WebSocket (Socket.IO): có header Upgrade thì giữ kết nối, không thì đóng như request thường
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# HTTP: chỉ phục vụ xác minh tên miền của Let's Encrypt, còn lại chuyển sang HTTPS
server {
  listen 80;
  listen [::]:80;
  server_name ${APP_DOMAIN};
  server_tokens off;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${APP_DOMAIN};
  server_tokens off;

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  # DNS nội bộ của Docker: phân giải lại tên "backend" mỗi 10 giây, nên backend tạo lại (deploy mới,
  # đổi IP) vẫn tới được mà không phải reload Nginx; Nginx cũng khởi động được khi backend chưa chạy
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend http://backend:3000;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  root /usr/share/nginx/html;

  # API REST, phát media (/api/v1/media/*)
  location /api/ {
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    include /etc/nginx/snippets/proxy-headers.conf;
    # Tệp nhập câu hỏi .zip tối đa 100 MB (backend/src/modules/question-import/import-format.ts)
    client_max_body_size 110m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # Socket.IO namespace /notifications (SPRINT-56)
  location /socket.io/ {
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    include /etc/nginx/snippets/proxy-headers.conf;
    # Kết nối giữ lâu: Socket.IO ping 25 giây một lần nên 1 giờ là dư
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # JS, CSS của Vite có mã băm trong tên tệp: cache lâu
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: đường dẫn nào không phải tệp thì trả index.html (React Router xử lý); index.html không cache
  # để deploy mới có hiệu lực ngay
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
