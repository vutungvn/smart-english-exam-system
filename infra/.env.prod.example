# Mẫu biến môi trường production/staging. Trên máy chủ: cp infra/.env.prod.example infra/.env.prod
# rồi điền giá trị thật. infra/.env.prod KHÔNG commit (đã có trong .gitignore).
# Sinh secret: openssl rand -base64 48   ·   Mật khẩu dùng trong URL (Postgres): openssl rand -hex 24
# DATABASE_URL, REDIS_URL, S3_ENDPOINT, NODE_ENV do docker-compose.prod.yml tự đặt, không khai ở đây.

# ---- Tên miền, HTTPS ----
# Hostname No-IP trỏ về Elastic IP của EC2 (không kèm https://)
APP_DOMAIN=smartexam.ddns.net
# Email nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt
CERTBOT_EMAIL=

# ---- Ứng dụng ----
PORT=3000
APP_URL=https://smartexam.ddns.net

# ---- PostgreSQL ----
POSTGRES_USER=smart_exam
POSTGRES_PASSWORD=
POSTGRES_DB=smart_exam
DATABASE_POOL_MAX=20

# ---- JWT (2 secret khác nhau, mỗi cái ≥ 32 ký tự) ----
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=604800

# ---- Gmail SMTP (App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart English Exam <your-email@gmail.com>"

# ---- Google OAuth: để trống cả hai thì tắt đăng nhập Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://smartexam.ddns.net/api/v1/auth/google/callback

# ---- Kho tệp RustFS (cũng là tài khoản đăng nhập giao diện quản lý) ----
S3_REGION=us-east-1
S3_ACCESS_KEY=smart_exam
S3_SECRET_KEY=
S3_BUCKET=smart-english-exam

# ---- AI (Gemini). Để trống GEMINI_API_KEY thì dùng dữ liệu mẫu (FakeAiProvider) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_DAILY_BUDGET=1000
AI_EXPLAIN_DAILY_LIMIT=20

# ---- Dữ liệu cá nhân ----
RECORDING_RETENTION_DAYS=30

# ---- Seed (chỉ service migrate dùng) ----
# Mật khẩu tài khoản admin tạo lần đầu (bắt buộc ở production, ít nhất 12 ký tự)
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=
